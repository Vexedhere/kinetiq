# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL — server-side only
DATABASE_URL=

# Authentication — configure a trusted auth provider before production
AUTH_SECRET=

# Supabase Auth + Realtime (public browser credentials only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY

# Socket.IO real-time server (server-side URL and public client URL)
REALTIME_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000

# S3-compatible media storage (keep secret key server-side)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# WebRTC voice signaling/TURN — configure for production
NEXT_PUBLIC_TURN_URL=
# Keep TURN username/credential server-side; do not prefix secrets with NEXT_PUBLIC_.
